---
// A small pill label, e.g. a technology or a project status.
// Renders an <li> by default, so place it inside a <ul>; pass as="span" to
// use it outside a list.

interface Props {
  as?: 'li' | 'span';
  variant?: 'default' | 'status';
}

const { as: Element = 'li', variant = 'default' } = Astro.props;

const variants = {
  default: 'bg-brand/10 py-1 text-sm',
  status: 'bg-amber-100 py-0.5 text-xs text-amber-800',
};
---

<Element class:list={['rounded-full px-3', variants[variant]]}><slot /></Element>
