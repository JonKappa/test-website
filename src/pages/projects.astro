---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Project Z Defense',
    tech: ['Java'],
    status: 'In progress',
    summary:
      'A wave-based survival game where you defend against monsters coming from every direction. Each wave brings more and stronger enemies, which can drop better weapons with longer range or faster attacks.',
    highlights: [
      'Sprite animation rendered with JFrame and JPanel',
      'Player movement and attacks driven by ActionListener input handling',
    ],
  },
  {
    name: 'CLI Dungeons & Dragons Game',
    tech: ['Java'],
    summary:
      'A turn-based battle game in the console. Each side picks a character, the faster one attacks first, and the defender counterattacks, until one team’s characters have all fainted.',
    highlights: ['Polymorphism used to share a template for player and computer behavior', 'Live character stats for both sides'],
  },
  {
    name: 'CLI Blackjack',
    tech: ['Java'],
    summary:
      'Blackjack against a computer dealer in the console. Bet, double, split, or stand, then the computer plays its hand and the closer to 21 wins.',
    highlights: [
      'Cards and deck modeled as encapsulated objects',
      'Polymorphism used for the player and computer hands',
    ],
  },
  {
    name: 'CLI Calculator',
    tech: ['Java'],
    summary:
      'A simple console calculator: pick addition, subtraction, multiplication, or division, enter two numbers, and get the result.',
    highlights: [],
  },
];
---

<Layout title="Projects | Jonathan Capparell">
  <h1>Projects</h1>
  <p class="mx-auto max-w-2xl text-gray-600">A few things I've built on my own time.</p>

  <div class="mx-auto grid max-w-5xl gap-6 py-8 text-left md:grid-cols-2">
    {
      projects.map((project) => (
        <article class="flex flex-col rounded-lg border border-gray-200 p-6 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-xl font-medium">{project.name}</h2>
            {project.status && (
              <span class="rounded-full bg-amber-100 px-3 py-0.5 text-xs text-amber-800">{project.status}</span>
            )}
          </div>
          <ul class="mt-2 flex flex-wrap gap-2">
            {project.tech.map((t) => (
              <li class="rounded-full bg-[rgb(53,53,112)]/10 px-3 py-0.5 text-sm">{t}</li>
            ))}
          </ul>
          <p class="mt-3">{project.summary}</p>
          {project.highlights.length > 0 && (
            <ul class="mt-3 list-disc pl-5 text-sm text-gray-700">
              {project.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</Layout>
