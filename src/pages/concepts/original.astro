---
// Concept: "Original". The current site exactly as it looks today, with the
// Home, Projects and Contact pages stacked into one scrolling page. The nav
// keeps its indigo bar and sliding white highlight, which now follows the
// section in view instead of the current page.
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import Tag from '../../components/Tag.astro';
import { skills } from '../../data/skills';
import { projects } from '../../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { id: 'projects', label: 'Projects' },
  { id: 'contact', label: 'Contact' },
];

const inputClass =
  'mt-1 block w-full rounded border border-gray-300 px-3 py-2 shadow-sm focus:border-brand focus:ring-2 focus:ring-brand/30 focus:outline-none';
---

<ConceptLayout name="Original">
  <nav class="sticky top-0 z-40 flex bg-brand text-white">
    <ul id="original-nav" class="relative flex">
      <span
        id="original-indicator"
        aria-hidden="true"
        class="absolute inset-y-0 left-0 bg-white transition-[translate,width] duration-300 ease-in-out motion-reduce:transition-none"
      >
      </span>
      <li class="group relative transition duration-250 hover:bg-brand-hover has-aria-[current]:hover:bg-transparent">
        <a href="#home" data-spy class="peer relative z-1 flex h-full items-center">
          <img
            class="my-2.5 mr-5 hidden h-16 w-[105px] group-has-aria-[current]:block"
            src={`${base}/assets/high-black-trans-logo.png`}
            alt="JonKappa"
            height="64"
            width="100"
          />
          <img
            class="my-2.5 mr-5 h-16 w-[105px] group-has-aria-[current]:hidden"
            src={`${base}/assets/high-white-trans-logo.png`}
            alt="JonKappa"
            height="64"
            width="100"
          />
        </a>
      </li>
      {
        links.map((link) => (
          <li class="relative transition duration-250 hover:bg-brand-hover has-aria-[current]:text-black has-aria-[current]:hover:bg-transparent">
            <a href={`#${link.id}`} data-spy class="relative z-1 flex h-full items-center px-8">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mx-auto mt-4 max-w-[1140px] px-3 text-center">
    <section id="home" class="scroll-mt-24">
      <div class="py-8">
        <h1>Jonathan Capparell</h1>
        <p class="text-xl text-gray-600">Software Developer · Delaware</p>
        <p class="mx-auto mt-4 max-w-2xl">
          I’ve been a full-stack developer at Harvard Business Services since 2022, building and maintaining their
          customer-facing website, Client Portal, and internal admin tools with PHP, Laravel, Livewire, Vue, Alpine.js,
          and ColdFusion. I got my start writing Java, and I still enjoy building games and command-line programs in my
          spare time.
        </p>
        <div class="mt-6 flex justify-center gap-4">
          <a href="#projects" class="rounded bg-brand px-5 py-2 text-white hover:bg-brand-hover">View projects</a>
          <a href="#contact" class="rounded border border-brand px-5 py-2 text-brand hover:bg-gray-100">Get in touch</a>
        </div>
      </div>

      <div class="mx-auto max-w-3xl py-6">
        <h2 class="mb-8 text-center text-3xl font-medium">Skills</h2>
        <ul class="flex flex-wrap justify-center gap-x-3 gap-y-9">
          {
            skills.map((skill) => (
              <li
                tabindex="0"
                class="group relative flex size-26 items-center justify-center rounded-lg border border-gray-200 bg-white shadow-sm transition duration-200 outline-brand reveal:border-brand reveal:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:transition-none"
              >
                <img
                  src={`${base}/assets/skills/${skill.logo}`}
                  alt={skill.name}
                  class="size-14 object-contain transition-transform duration-200 group-reveal:scale-125 motion-reduce:transition-none"
                  width="56"
                  height="56"
                />
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute top-full left-1/2 z-10 mt-2 -translate-x-1/2 rounded bg-gray-900 px-2 py-1 text-xs whitespace-nowrap text-white opacity-0 transition-opacity duration-200 group-reveal:opacity-100"
                >
                  {skill.name}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="projects" class="scroll-mt-24 pt-12">
      <h2 class="mb-2 text-[2.5rem] leading-tight font-medium">Projects</h2>
      <p class="mx-auto max-w-2xl text-gray-600">A few things I’ve built on my own time.</p>

      <div class="mx-auto grid max-w-5xl gap-6 py-8 text-left md:grid-cols-2">
        {
          projects.map((project) => (
            <article class="flex flex-col rounded-lg border border-gray-200 p-6 shadow-sm">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-xl font-medium">{project.name}</h3>
                {project.status && (
                  <Tag as="span" variant="status">
                    {project.status}
                  </Tag>
                )}
              </div>
              <ul class="mt-2 flex flex-wrap gap-2">
                {project.tech.map((t) => (
                  <Tag>{t}</Tag>
                ))}
              </ul>
              <p class="mt-3">{project.summary}</p>
              {project.highlights && project.highlights.length > 0 && (
                <ul class="mt-3 list-disc pl-5 text-sm text-gray-700">
                  {project.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section id="contact" class="scroll-mt-24 pt-12">
      <h2 class="mb-2 text-[2.5rem] leading-tight font-medium">Contact</h2>
      <p class="mx-auto max-w-xl text-gray-600">Have a question or an opportunity? Send me a message.</p>

      <form
        name="contact"
        method="POST"
        action={`${base}/contact/thanks/`}
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mx-auto mt-8 mb-12 grid max-w-xl gap-5 text-left sm:grid-cols-2"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden" aria-hidden="true">
          <label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <label class="block">
          <span class="font-medium">First name</span>
          <input type="text" name="firstName" autocomplete="given-name" required class={inputClass} />
        </label>
        <label class="block">
          <span class="font-medium">Last name</span>
          <input type="text" name="lastName" autocomplete="family-name" required class={inputClass} />
        </label>
        <label class="block sm:col-span-2">
          <span class="font-medium">Email</span>
          <input type="email" name="email" autocomplete="email" required class={inputClass} />
        </label>
        <label class="block sm:col-span-2">
          <span class="font-medium">Message</span>
          <textarea name="message" rows="6" required class={inputClass}></textarea>
        </label>
        <div class="sm:col-span-2">
          <button type="submit" class="rounded bg-brand px-5 py-2 text-white hover:bg-brand-hover">Send</button>
        </div>
      </form>
    </section>
  </div>

  <footer class="bg-black pt-[1%] pb-[3%] text-center text-white">
    Created by <a href="#home" class="text-[blue] underline">Jonathan Capparell</a> | ©{new Date().getFullYear()}
    <br />All rights reserved.
  </footer>

  <script>
    // Slide the white highlight under whichever nav link the layout's
    // scroll-spy has marked aria-current.
    const nav = document.getElementById('original-nav')!;
    const indicator = document.getElementById('original-indicator')!;

    const move = () => {
      const li = nav.querySelector('a[aria-current]')?.parentElement;
      if (!li) return;
      indicator.style.translate = `${li.offsetLeft}px 0`;
      indicator.style.width = `${li.offsetWidth}px`;
    };

    new MutationObserver(move).observe(nav, { subtree: true, attributeFilter: ['aria-current'] });
    window.addEventListener('resize', move);
    move();
  </script>
</ConceptLayout>
