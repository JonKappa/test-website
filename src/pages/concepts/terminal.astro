---
// Concept: "Terminal". A dark, monospace page that leans into the CLI games
// in the project list: each section reads like a command and its output.
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { skills } from '../../data/skills';
import { projects } from '../../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const slug = (name: string) =>
  name
    .toLowerCase()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const nav = [
  { id: 'home', label: '~/home' },
  { id: 'projects', label: '~/projects' },
  { id: 'contact', label: '~/contact' },
];

const fields = [
  { name: 'firstName', label: 'first_name', type: 'text', autocomplete: 'given-name' },
  { name: 'lastName', label: 'last_name', type: 'text', autocomplete: 'family-name' },
  { name: 'email', label: 'email', type: 'email', autocomplete: 'email' },
] as const;
---

<ConceptLayout
  name="Terminal"
  fonts="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;800&display=swap"
>
  <div class="min-h-screen bg-[#0b0d17] font-['JetBrains_Mono',ui-monospace,monospace] text-[#c9cbe0] selection:bg-[#8b8bf0]/40">
    <header class="sticky top-0 z-40 border-b border-white/10 bg-[#11142a]/90 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center gap-4 px-4">
        <div aria-hidden="true" class="hidden gap-1.5 sm:flex">
          <span class="size-3 rounded-full bg-[#ff5f57]"></span>
          <span class="size-3 rounded-full bg-[#febc2e]"></span>
          <span class="size-3 rounded-full bg-[#28c840]"></span>
        </div>
        <ul class="flex text-xs sm:text-sm">
          {
            nav.map((n) => (
              <li>
                <a
                  href={`#${n.id}`}
                  data-spy
                  class="block border-b-2 border-transparent px-2.5 py-3.5 text-[#7c7fa6] transition hover:text-white aria-[current]:border-[#8b8bf0] aria-[current]:text-white sm:px-4"
                >
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
        <img
          src={`${base}/assets/high-white-trans-logo.png`}
          alt="JonKappa"
          class="ml-auto hidden h-9 w-auto opacity-80 sm:block"
          width="59"
          height="36"
        />
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4">
      <section id="home" class="scroll-mt-14 py-16 sm:py-24">
        <p class="text-[#7ee2a8]">$ <span class="text-[#c9cbe0]">whoami</span></p>
        <h1 class="mt-3 text-4xl leading-none font-extrabold tracking-tight text-white sm:text-7xl">
          Jonathan<br />Capparell<span class="animate-pulse text-[#8b8bf0]">_</span>
        </h1>
        <p class="mt-4 text-[#8b8bf0]">software developer @ delaware</p>

        <p class="mt-12 text-[#7ee2a8]">$ <span class="text-[#c9cbe0]">cat about.txt</span></p>
        <p class="mt-3 max-w-2xl leading-relaxed">
          Full-stack developer at Harvard Business Services since 2022, building and maintaining their customer-facing
          website, Client Portal and internal admin tools. Got my start writing Java, and I still build games and
          command-line programs in my spare time.
        </p>

        <p class="mt-12 text-[#7ee2a8]">$ <span class="text-[#c9cbe0]">ls skills/</span></p>
        <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
          {
            skills.map((s) => (
              <li class="flex items-center gap-3 rounded border border-white/10 bg-white/[0.03] px-3 py-2 text-sm transition hover:border-[#8b8bf0]/60 hover:bg-[#8b8bf0]/10">
                <img src={`${base}/assets/skills/${s.logo}`} alt="" class="size-5 object-contain" width="20" height="20" />
                {s.name}
              </li>
            ))
          }
        </ul>

        <div class="mt-12 flex flex-wrap gap-3 text-sm">
          <a href="#projects" class="rounded bg-[#8b8bf0] px-4 py-2.5 font-semibold text-[#0b0d17] transition hover:bg-white">
            cd projects/
          </a>
          <a href="#contact" class="rounded border border-[#8b8bf0]/60 px-4 py-2.5 text-[#8b8bf0] transition hover:bg-[#8b8bf0]/10">
            ./contact.sh
          </a>
        </div>
      </section>

      <section id="projects" class="scroll-mt-14 border-t border-white/10 py-16 sm:py-24">
        <p class="text-[#7ee2a8]">$ <span class="text-[#c9cbe0]">ls -l projects/</span></p>
        <h2 class="mt-3 text-3xl font-extrabold text-white sm:text-4xl">Projects</h2>
        <p class="mt-2 text-sm text-[#7c7fa6]">total {projects.length} · things I’ve built on my own time</p>

        <div class="mt-8 space-y-4">
          {
            projects.map((p) => (
              <article class="group rounded border border-white/10 bg-white/[0.02] p-5 transition hover:border-[#8b8bf0]/50 sm:p-6">
                <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#7c7fa6]">
                  <span class="hidden sm:inline">drwxr-xr-x</span>
                  <span>{p.tech.join(', ').toLowerCase()}</span>
                  <span class="text-[#8b8bf0]">{slug(p.name)}/</span>
                  {p.status && <span class="rounded bg-[#febc2e]/15 px-2 py-0.5 text-[#febc2e]">{p.status.toLowerCase()}</span>}
                </p>
                <h3 class="mt-3 text-lg font-semibold text-white group-hover:text-[#8b8bf0] sm:text-xl">{p.name}</h3>
                <p class="mt-2 max-w-3xl text-sm leading-relaxed">{p.summary}</p>
                {p.highlights && (
                  <ul class="mt-3 space-y-1 text-sm text-[#7c7fa6]">
                    {p.highlights.map((h) => (
                      <li>
                        <span class="text-[#7ee2a8]">+</span> {h}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section id="contact" class="scroll-mt-14 border-t border-white/10 py-16 sm:py-24">
        <p class="text-[#7ee2a8]">$ <span class="text-[#c9cbe0]">./contact.sh</span></p>
        <h2 class="mt-3 text-3xl font-extrabold text-white sm:text-4xl">Contact</h2>
        <p class="mt-2 text-sm text-[#7c7fa6]">Have a question or an opportunity? Send me a message.</p>

        <form
          name="contact"
          method="POST"
          action={`${base}/contact/thanks/`}
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="mt-8 max-w-2xl space-y-4 rounded border border-white/10 bg-[#11142a] p-5 sm:p-6"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          {
            fields.map((f) => (
              <label class="flex flex-col gap-1 text-sm sm:flex-row sm:items-center sm:gap-3">
                <span class="shrink-0 text-[#8b8bf0] sm:w-28">{f.label}:</span>
                <input
                  type={f.type}
                  name={f.name}
                  autocomplete={f.autocomplete}
                  required
                  class="w-full border-b border-white/15 bg-transparent py-1.5 text-white caret-[#7ee2a8] focus:border-[#7ee2a8] focus:outline-none"
                />
              </label>
            ))
          }
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-[#8b8bf0]">message:</span>
            <textarea
              name="message"
              rows="5"
              required
              class="w-full rounded border border-white/15 bg-black/20 p-3 text-white caret-[#7ee2a8] focus:border-[#7ee2a8] focus:outline-none"
            ></textarea>
          </label>
          <button
            type="submit"
            class="rounded bg-[#7ee2a8] px-4 py-2.5 text-sm font-semibold text-[#0b0d17] transition hover:bg-white"
          >
            send ↵
          </button>
        </form>
      </section>
    </main>

    <footer class="border-t border-white/10 py-8 pb-20 text-center text-xs text-[#7c7fa6]">
      <span class="text-[#7ee2a8]">$</span> echo "© {new Date().getFullYear()} Jonathan Capparell"
    </footer>
  </div>
</ConceptLayout>
