---
// Index of the one-page redesign concepts. Each one puts Home, Projects and
// Contact on a single scrolling page.
import ConceptLayout from '../../layouts/ConceptLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const concepts = [
  {
    slug: 'original',
    name: 'Original',
    blurb: 'The current site as it is today, with Home, Projects and Contact stacked on one page. The nav highlight slides to the section in view.',
    swatch: 'border-t-[18px] border-brand bg-white ring-1 ring-gray-300',
  },
  {
    slug: 'studio',
    name: 'Studio',
    blurb: 'The current indigo brand, polished. Sticky pill nav, a bold hero, a featured project and a side-by-side contact form.',
    swatch: 'bg-brand',
  },
  {
    slug: 'terminal',
    name: 'Terminal',
    blurb: 'Dark and monospace. Each section reads like a shell command, a nod to the CLI games in the project list.',
    swatch: 'bg-[#0b0d17]',
  },
  {
    slug: 'editorial',
    name: 'Editorial',
    blurb: 'Warm paper, big serif type and numbered sections, with a sidebar nav on wide screens.',
    swatch: 'bg-[#f6f3ec] ring-1 ring-gray-300',
  },
];
---

<ConceptLayout name="Concepts">
  <main class="mx-auto max-w-4xl px-4 py-16 text-[#212529]">
    <h1>Redesign concepts</h1>
    <p class="max-w-2xl text-gray-600">
      Four directions for the site. Each puts Home, Projects and Contact on one scrolling page, using the same
      content as the live site.
    </p>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        concepts.map((c) => (
          <li>
            <a
              href={`${base}/concepts/${c.slug}/`}
              class="block h-full rounded-xl border border-gray-200 p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand hover:shadow-md"
            >
              <span class:list={['block h-20 rounded-lg', c.swatch]} />
              <h2 class="mt-4 text-xl font-medium">{c.name}</h2>
              <p class="mt-2 text-sm text-gray-600">{c.blurb}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</ConceptLayout>
