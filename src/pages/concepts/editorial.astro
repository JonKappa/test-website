---
// Concept: "Editorial". A magazine-style page on warm paper: big serif type,
// numbered sections and a sidebar nav on wide screens. The indigo brand
// becomes the accent color instead of the background.
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { skills } from '../../data/skills';
import { projects } from '../../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nav = [
  { id: 'home', label: 'Home' },
  { id: 'projects', label: 'Projects' },
  { id: 'contact', label: 'Contact' },
];

const num = (i: number) => String(i + 1).padStart(2, '0');

const inputClass =
  'mt-1 block w-full border-0 border-b border-[#1c1c2e]/25 bg-transparent px-0 py-2 text-lg focus:border-brand focus:ring-0 focus:outline-none';
---

<ConceptLayout
  name="Editorial"
  fonts="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500&display=swap"
>
  <div class="min-h-screen bg-[#f6f3ec] font-['Inter',sans-serif] text-[#1c1c2e] lg:grid lg:grid-cols-[17rem_1fr]">
    <aside
      class="sticky top-0 z-40 flex items-center justify-between border-b border-[#1c1c2e]/10 bg-[#f6f3ec]/90 px-4 py-3 backdrop-blur lg:h-screen lg:flex-col lg:items-start lg:justify-between lg:border-r lg:border-b-0 lg:px-8 lg:py-10"
    >
      <a href="#home" class="flex items-center gap-3">
        <img src={`${base}/assets/high-black-trans-logo.png`} alt="" class="h-9 w-auto lg:h-14" width="59" height="36" />
        <span class="hidden font-['Fraunces',serif] text-lg leading-tight lg:block">Jonathan<br />Capparell</span>
      </a>
      <ul class="flex gap-4 text-sm lg:flex-col lg:gap-3 lg:text-base">
        {
          nav.map((n, i) => (
            <li>
              <a
                href={`#${n.id}`}
                data-spy
                class="group flex items-baseline gap-2 text-[#1c1c2e]/55 transition hover:text-[#1c1c2e] aria-[current]:text-brand"
              >
                <span class="hidden text-xs tabular-nums lg:inline">{num(i)}</span>
                <span class="border-b border-transparent group-aria-[current]:border-brand">{n.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="hidden text-xs text-[#1c1c2e]/50 lg:block">Software Developer<br />Delaware, USA</p>
    </aside>

    <main class="px-4 sm:px-10 lg:px-16">
      <section id="home" class="mx-auto max-w-4xl scroll-mt-16 py-16 sm:py-24 lg:scroll-mt-0">
        <p class="text-sm tracking-[0.2em] text-brand uppercase">01 — Home</p>
        <h1 class="mt-6 font-['Fraunces',serif] text-4xl leading-[1.05] font-normal sm:text-6xl lg:text-7xl">
          I build the websites, portals and tools a business <em class="text-brand">runs on.</em>
        </h1>
        <div class="mt-12 grid gap-10 border-t border-[#1c1c2e]/15 pt-8 md:grid-cols-[1fr_1fr]">
          <div>
            <p class="font-['Fraunces',serif] text-2xl">Jonathan Capparell</p>
            <p class="mt-1 text-sm text-[#1c1c2e]/60">Software Developer · Delaware</p>
            <p class="mt-5 leading-relaxed text-[#1c1c2e]/80">
              I’ve been a full-stack developer at Harvard Business Services since 2022, building and maintaining their
              customer-facing website, Client Portal and internal admin tools. I got my start writing Java, and I still
              enjoy building games and command-line programs in my spare time.
            </p>
          </div>
          <div>
            <p class="text-xs tracking-[0.2em] text-[#1c1c2e]/50 uppercase">Toolkit</p>
            <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
              {
                skills.map((s) => (
                  <li class="flex items-center gap-3 border-b border-[#1c1c2e]/10 pb-2">
                    <img src={`${base}/assets/skills/${s.logo}`} alt="" class="size-5 object-contain grayscale" width="20" height="20" />
                    {s.name}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section id="projects" class="mx-auto max-w-4xl scroll-mt-16 border-t border-[#1c1c2e]/15 py-16 sm:py-24 lg:scroll-mt-0">
        <p class="text-sm tracking-[0.2em] text-brand uppercase">02 — Projects</p>
        <h2 class="mt-6 font-['Fraunces',serif] text-4xl sm:text-5xl">Made on my own time.</h2>

        <ol class="mt-12">
          {
            projects.map((p, i) => (
              <li class="group grid gap-x-8 gap-y-3 border-t border-[#1c1c2e]/15 py-8 sm:grid-cols-[5rem_1fr]">
                <span class="font-['Fraunces',serif] text-4xl text-[#1c1c2e]/25 tabular-nums transition group-hover:text-brand sm:text-5xl">
                  {num(i)}
                </span>
                <div>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <h3 class="font-['Fraunces',serif] text-2xl sm:text-3xl">{p.name}</h3>
                    <p class="text-xs tracking-[0.15em] text-[#1c1c2e]/55 uppercase">
                      {p.tech.join(' · ')}
                      {p.status && <span class="ml-2 text-amber-700">· {p.status}</span>}
                    </p>
                  </div>
                  <p class="mt-3 max-w-2xl leading-relaxed text-[#1c1c2e]/80">{p.summary}</p>
                  {p.highlights && (
                    <ul class="mt-4 space-y-1 text-sm text-[#1c1c2e]/60">
                      {p.highlights.map((h) => (
                        <li class="before:mr-2 before:text-brand before:content-['—']">{h}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="contact" class="mx-auto max-w-4xl scroll-mt-16 border-t border-[#1c1c2e]/15 py-16 sm:py-24 lg:scroll-mt-0">
        <p class="text-sm tracking-[0.2em] text-brand uppercase">03 — Contact</p>
        <div class="mt-6 grid gap-12 md:grid-cols-[1fr_1.4fr]">
          <div>
            <h2 class="font-['Fraunces',serif] text-4xl sm:text-5xl">Say hello.</h2>
            <p class="mt-4 leading-relaxed text-[#1c1c2e]/70">
              Have a question or an opportunity? Send me a message and I’ll get back to you as soon as I can.
            </p>
          </div>
          <form
            name="contact"
            method="POST"
            action={`${base}/contact/thanks/`}
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="grid gap-6 sm:grid-cols-2"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden" aria-hidden="true">
              <label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>
            <label class="block text-xs tracking-[0.15em] text-[#1c1c2e]/55 uppercase">
              First name
              <input type="text" name="firstName" autocomplete="given-name" required class={inputClass} />
            </label>
            <label class="block text-xs tracking-[0.15em] text-[#1c1c2e]/55 uppercase">
              Last name
              <input type="text" name="lastName" autocomplete="family-name" required class={inputClass} />
            </label>
            <label class="block text-xs tracking-[0.15em] text-[#1c1c2e]/55 uppercase sm:col-span-2">
              Email
              <input type="email" name="email" autocomplete="email" required class={inputClass} />
            </label>
            <label class="block text-xs tracking-[0.15em] text-[#1c1c2e]/55 uppercase sm:col-span-2">
              Message
              <textarea name="message" rows="4" required class={inputClass}></textarea>
            </label>
            <div class="sm:col-span-2">
              <button
                type="submit"
                class="group inline-flex items-center gap-3 rounded-full bg-[#1c1c2e] px-7 py-3.5 text-white transition hover:bg-brand"
              >
                Send message <span class="transition group-hover:translate-x-1">→</span>
              </button>
            </div>
          </form>
        </div>
      </section>

      <footer class="mx-auto max-w-4xl border-t border-[#1c1c2e]/15 py-10 pb-20 text-sm text-[#1c1c2e]/50">
        © {new Date().getFullYear()} Jonathan Capparell
      </footer>
    </main>
  </div>
</ConceptLayout>
