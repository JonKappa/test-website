---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Message sent">
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="text-3xl font-semibold sm:text-4xl">Thanks for reaching out!</h1>
    <p class="mt-4 text-gray-600">Your message was sent. I’ll get back to you as soon as I can.</p>
    <a
      href={`${base}/`}
      class="mt-8 inline-block rounded-full bg-brand px-6 py-3 font-medium text-white transition hover:bg-brand-hover"
    >
      Back to home
    </a>
  </section>
</Layout>
