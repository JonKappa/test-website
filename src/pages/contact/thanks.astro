---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Message sent">
  <h1>Thanks for reaching out!</h1>
  <p class="mx-auto max-w-xl text-gray-600">Your message was sent. I’ll get back to you as soon as I can.</p>
  <a href={`${base}/`} class="mt-6 mb-12 inline-block rounded bg-brand px-5 py-2 text-white hover:bg-brand-hover">
    Back to home
  </a>
</Layout>
