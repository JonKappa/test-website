---
import Layout from '../layouts/Layout.astro';
import { skills } from '../data/skills';
import { projects } from '../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [featured, ...rest] = projects;

const inputClass =
  'mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 focus:border-brand focus:ring-4 focus:ring-brand/15 focus:outline-none';
---

<Layout>
  <section id="home" class="relative scroll-mt-16 overflow-hidden bg-brand text-white">
    <div
      aria-hidden="true"
      class="absolute inset-0 opacity-15 [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:48px_48px] [mask-image:radial-gradient(ellipse_at_top_right,black,transparent_70%)]"
    >
    </div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:py-24 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="text-sm font-medium tracking-wide text-indigo-200 uppercase">Software Developer · Delaware</p>
        <h1 class="mt-3 text-4xl leading-tight font-semibold sm:text-6xl">Jonathan Capparell</h1>
        <p class="mt-5 max-w-xl text-lg text-indigo-100">
          Full-stack developer building customer-facing sites, client portals and the internal tools that keep a
          business running. I started out writing Java and still build games and command-line programs for fun.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#projects" class="rounded-full bg-white px-6 py-3 font-medium text-brand transition hover:bg-indigo-50">
            View projects
          </a>
          <a href="#contact" class="rounded-full border border-white/40 px-6 py-3 font-medium transition hover:bg-white/10">
            Get in touch
          </a>
        </div>
      </div>

      <div class="rounded-2xl bg-white/10 p-6 ring-1 ring-white/20 backdrop-blur">
        <p class="text-xs font-medium tracking-wide text-indigo-200 uppercase">Currently</p>
        <p class="mt-2 text-xl font-semibold">Full-stack developer</p>
        <p class="text-indigo-100">Harvard Business Services · since 2022</p>
        <p class="mt-4 text-sm text-indigo-100">
          Building and maintaining the customer-facing website, Client Portal and internal admin tools.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2 text-xs">
          {
            ['PHP', 'Laravel', 'Livewire', 'Vue', 'Alpine.js', 'ColdFusion'].map((t) => (
              <li class="rounded-full bg-white/15 px-2.5 py-1">{t}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section aria-label="Skills" class="border-b border-gray-200 bg-white">
    <ul class="mx-auto flex max-w-6xl flex-wrap justify-center gap-x-4 gap-y-6 px-4 py-8">
      {
        skills.map((s) => (
          <li class="flex w-20 flex-col items-center gap-2">
            <img src={`${base}/assets/skills/${s.logo}`} alt="" class="size-9 object-contain" width="36" height="36" />
            <span class="text-xs text-gray-500">{s.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="projects" class="scroll-mt-16 bg-gray-50">
    <div class="mx-auto max-w-6xl px-4 py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="mt-1 text-3xl font-semibold sm:text-4xl">Projects</h2>
        </div>
      </div>

      <article class="mt-10 grid overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-200 md:grid-cols-2">
        <div
          aria-hidden="true"
          class="relative flex min-h-48 items-center justify-center bg-[radial-gradient(circle_at_center,var(--color-brand-hover),var(--color-brand))]"
        >
          <div class="grid grid-cols-5 gap-2 opacity-80">
            {Array.from({ length: 25 }, (_, i) => (
              <span class:list={['size-5 rounded-sm', i === 12 ? 'bg-amber-300' : i % 7 === 0 ? 'bg-rose-400' : 'bg-white/15']} />
            ))}
          </div>
        </div>
        <div class="p-8">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">{featured.status}</span>
            {featured.tech.map((t) => <span class="rounded-full bg-brand/10 px-2.5 py-0.5 text-xs">{t}</span>)}
          </div>
          <h3 class="mt-3 text-2xl font-semibold">{featured.name}</h3>
          <p class="mt-3 text-gray-700">{featured.summary}</p>
          <ul class="mt-4 space-y-1.5 text-sm text-gray-600">
            {featured.highlights?.map((h) => <li class="flex gap-2"><span class="text-brand">→</span>{h}</li>)}
          </ul>
        </div>
      </article>

      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {
          rest.map((p) => (
            <article class="flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 transition hover:-translate-y-0.5 hover:shadow-md">
              <div class="flex flex-wrap gap-2">
                {p.tech.map((t) => (
                  <span class="rounded-full bg-brand/10 px-2.5 py-0.5 text-xs">{t}</span>
                ))}
              </div>
              <h3 class="mt-3 text-lg font-semibold">{p.name}</h3>
              <p class="mt-2 text-sm text-gray-700">{p.summary}</p>
              {p.highlights && (
                <ul class="mt-auto space-y-1 border-t border-gray-100 pt-4 text-xs text-gray-500">
                  {p.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="scroll-mt-16 bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <h2 class="mt-1 text-3xl font-semibold text-gray-900 sm:text-4xl">Let’s talk</h2>
        <p class="mt-4 max-w-md text-gray-600">
          Have a question or an opportunity? Send me a message and I’ll get back to you as soon as I can.
        </p>
        <dl class="mt-8 space-y-4 text-sm">
          <div>
            <dt class="text-gray-500">Based in</dt>
            <dd class="font-medium">Delaware, USA</dd>
          </div>
        </dl>
      </div>

      <form
        name="contact"
        method="POST"
        action={`${base}/contact/thanks/`}
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="grid gap-5 rounded-2xl bg-gray-50 p-6 ring-1 ring-gray-200 sm:grid-cols-2 sm:p-8"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden" aria-hidden="true">
          <label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <label class="block text-sm font-medium">
          First name
          <input type="text" name="firstName" autocomplete="given-name" required class={inputClass} />
        </label>
        <label class="block text-sm font-medium">
          Last name
          <input type="text" name="lastName" autocomplete="family-name" required class={inputClass} />
        </label>
        <label class="block text-sm font-medium sm:col-span-2">
          Email
          <input type="email" name="email" autocomplete="email" required class={inputClass} />
        </label>
        <label class="block text-sm font-medium sm:col-span-2">
          Message
          <textarea name="message" rows="5" required class={inputClass}></textarea>
        </label>
        <div class="sm:col-span-2">
          <button type="submit" class="rounded-full bg-brand px-6 py-3 font-medium text-white transition hover:bg-brand-hover">
            Send message
          </button>
        </div>
      </form>
    </div>
  </section>
</Layout>
