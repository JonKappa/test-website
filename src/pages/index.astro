---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Logo files in public/assets/skills. The SVGs come from devicon (MIT, see
// LICENSE-devicon.txt); coldfusion.webp is Adobe's ColdFusion logo.
const skills: { name: string; logo: string }[] = [
  { name: 'Java', logo: 'java.svg' },
  { name: 'Python', logo: 'python.svg' },
  { name: 'C#', logo: 'csharp.svg' },
  { name: 'PHP', logo: 'php.svg' },
  { name: 'ColdFusion', logo: 'coldfusion.webp' },
  { name: 'JavaScript', logo: 'javascript.svg' },
  { name: 'Laravel', logo: 'laravel.svg' },
  { name: 'Livewire', logo: 'livewire.svg' },
  { name: 'Vue', logo: 'vuejs.svg' },
  { name: 'Alpine.js', logo: 'alpinejs.svg' },
  { name: 'React', logo: 'react.svg' },
  { name: 'Spring Boot', logo: 'spring.svg' },
];

interface Job {
  role: string;
  company: string;
  location: string;
  dates: string;
  points: string[];
}

interface Certification {
  name: string;
  issuer: string;
  year: number;
}

const experience: Job[] = [
  {
    role: 'Software Developer',
    company: 'Harvard Business Services',
    location: 'Lewes, DE',
    dates: '2022 – Present',
    points: [
      'Build and maintain the front and back end of customer-facing sites, including the main website and the Client Portal.',
      'Develop and improve the internal admin site staff use to process orders and manage company records.',
      'Lead high-priority features and workflow improvements, and modernize legacy code to current standards.',
      'Review other developers’ projects and give feedback on improvements and bugs.',
    ],
  },
  {
    role: 'Software Engineer Apprentice',
    company: 'Code Differently',
    location: 'Wilmington, DE',
    dates: '2021 – 2022',
    points: [
      'Built REST APIs with Spring Boot and user interfaces with React.',
      'Practiced core Java, software development methodologies, and problem solving through coding assessments.',
    ],
  },
];

const certifications: Certification[] = [
  { name: 'Certified ScrumMaster (CSM)', issuer: 'Scrum Alliance', year: 2021 },
  { name: 'Java Foundations Associate', issuer: 'Oracle', year: 2021 },
];
---

<Layout>
  <section class="py-8">
    <h1>Jonathan Capparell</h1>
    <p class="text-xl text-gray-600">Software Developer · Delaware</p>
    <p class="mx-auto mt-4 max-w-2xl">
      I’m a full-stack developer at Harvard Business Services, where I build and maintain customer-facing websites and
      internal tools with PHP, Laravel, Livewire, Vue, Alpine.js, and ColdFusion. I got my start writing Java, and I still
      enjoy building games and command-line programs in my spare time.
    </p>
    <div class="mt-6 flex justify-center gap-4">
      <a href={`${base}/projects/`} class="rounded bg-brand px-5 py-2 text-white hover:bg-brand-hover">
        View projects
      </a>
      <a
        href={`${base}/contact/`}
        class="rounded border border-brand px-5 py-2 text-brand hover:bg-gray-100"
      >
        Get in touch
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl py-6">
    <h2 class="mb-8 text-center text-3xl font-medium">Skills</h2>
    <ul class="flex flex-wrap justify-center gap-x-3 gap-y-9">
      {
        skills.map((skill) => (
          <li
            tabindex="0"
            class="group relative flex size-26 items-center justify-center rounded-lg border border-gray-200 bg-white shadow-sm transition duration-200 outline-brand hover:border-brand hover:shadow-md focus-visible:border-brand focus-visible:shadow-md pointer-coarse:focus:border-brand pointer-coarse:focus:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:transition-none"
          >
            <img
              src={`${base}/assets/skills/${skill.logo}`}
              alt={skill.name}
              class="size-14 object-contain transition-transform duration-200 group-hover:scale-125 group-focus-visible:scale-125 pointer-coarse:group-focus:scale-125 motion-reduce:transition-none"
              width="56"
              height="56"
            />
            <span
              aria-hidden="true"
              class="pointer-events-none absolute top-full left-1/2 z-10 mt-2 -translate-x-1/2 rounded bg-gray-900 px-2 py-1 text-xs whitespace-nowrap text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 pointer-coarse:group-focus:opacity-100"
            >
              {skill.name}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-3xl py-6 text-left">
    <h2 class="mb-4 text-2xl font-medium">Experience</h2>
    {
      experience.map((job) => (
        <article class="mb-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="text-lg font-medium">
              {job.role} · {job.company}
            </h3>
            <span class="text-sm text-gray-600">{job.dates}</span>
          </div>
          <p class="text-sm text-gray-600">{job.location}</p>
          <ul class="mt-2 list-disc pl-5">
            {job.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section class="mx-auto grid max-w-3xl gap-8 py-6 pb-12 text-left sm:grid-cols-2">
    <div>
      <h2 class="mb-4 text-2xl font-medium">Certifications</h2>
      <ul>
        {
          certifications.map((cert) => (
            <li class="mb-2">
              <span class="font-medium">{cert.name}</span>
              <br />
              <span class="text-sm text-gray-600">
                {cert.issuer}, {cert.year}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="mb-4 text-2xl font-medium">Education</h2>
      <p class="font-medium">Computer Science</p>
      <p class="text-sm text-gray-600">Delaware Technical Community College, Georgetown, DE · 2024</p>
    </div>
  </section>
</Layout>
