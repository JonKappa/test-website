---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Logos in public/assets/skills come from devicon (MIT, see LICENSE-devicon.txt).
// ColdFusion has no openly licensed logo, so it gets a text badge instead.
const skills: { name: string; icon?: string; badge?: string }[] = [
  { name: 'Java', icon: 'java' },
  { name: 'Python', icon: 'python' },
  { name: 'C#', icon: 'csharp' },
  { name: 'PHP', icon: 'php' },
  { name: 'ColdFusion', badge: 'Cf' },
  { name: 'JavaScript', icon: 'javascript' },
  { name: 'Laravel', icon: 'laravel' },
  { name: 'Livewire', icon: 'livewire' },
  { name: 'Vue', icon: 'vuejs' },
  { name: 'Alpine.js', icon: 'alpinejs' },
  { name: 'React', icon: 'react' },
  { name: 'Spring Boot', icon: 'spring' },
];

const experience = [
  {
    role: 'Software Developer',
    company: 'Harvard Business Services',
    location: 'Lewes, DE',
    dates: '2022 – Present',
    points: [
      'Build and maintain the front and back end of customer-facing sites, including the main website and the Client Portal.',
      'Develop and improve the internal admin site staff use to process orders and manage company records.',
      'Lead high-priority features and workflow improvements, and modernize legacy code to current standards.',
      'Review other developers’ projects and give feedback on improvements and bugs.',
    ],
  },
  {
    role: 'Software Engineer Apprentice',
    company: 'Code Differently',
    location: 'Wilmington, DE',
    dates: '2021 – 2022',
    points: [
      'Built REST APIs with Spring Boot and user interfaces with React.',
      'Practiced core Java, software development methodologies, and problem solving through coding assessments.',
    ],
  },
];

const certifications = [
  { name: 'Certified ScrumMaster (CSM)', issuer: 'Scrum Alliance', year: 2021 },
  { name: 'Java Foundations Associate', issuer: 'Oracle', year: 2021 },
];
---

<Layout>
  <section class="py-8">
    <h1>Jonathan Capparell</h1>
    <p class="text-xl text-gray-600">Software Developer · Delaware</p>
    <p class="mx-auto mt-4 max-w-2xl">
      I’m a full-stack developer at Harvard Business Services, where I build and maintain customer-facing websites and
      internal tools with PHP, Laravel, Livewire, Vue, Alpine, and ColdFusion. I got my start writing Java, and I still
      enjoy building games and command-line programs in my spare time.
    </p>
    <div class="mt-6 flex justify-center gap-4">
      <a href={`${base}/projects/`} class="rounded bg-brand px-5 py-2 text-white hover:bg-brand-hover">
        View projects
      </a>
      <a
        href={`${base}/contact/`}
        class="rounded border border-brand px-5 py-2 text-brand hover:bg-gray-100"
      >
        Get in touch
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl py-6 text-left">
    <h2 class="mb-4 text-2xl font-medium">Skills</h2>
    <ul class="flex flex-wrap gap-3">
      {
        skills.map((skill) => (
          <li class="group relative flex size-20 items-center justify-center rounded-lg border border-gray-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-md motion-reduce:transition-none motion-reduce:hover:translate-y-0">
            {skill.icon ? (
              <img src={`${base}/assets/skills/${skill.icon}.svg`} alt={skill.name} class="size-12" width="48" height="48" />
            ) : (
              <span
                role="img"
                aria-label={skill.name}
                class="flex size-12 items-center justify-center rounded bg-[#0b3a5c] text-xl font-semibold text-white"
              >
                {skill.badge}
              </span>
            )}
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 rounded bg-gray-900 px-2 py-1 text-xs whitespace-nowrap text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100"
            >
              {skill.name}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-3xl py-6 text-left">
    <h2 class="mb-4 text-2xl font-medium">Experience</h2>
    {
      experience.map((job) => (
        <article class="mb-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="text-lg font-medium">
              {job.role} · {job.company}
            </h3>
            <span class="text-sm text-gray-600">{job.dates}</span>
          </div>
          <p class="text-sm text-gray-600">{job.location}</p>
          <ul class="mt-2 list-disc pl-5">
            {job.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section class="mx-auto grid max-w-3xl gap-8 py-6 pb-12 text-left sm:grid-cols-2">
    <div>
      <h2 class="mb-4 text-2xl font-medium">Certifications</h2>
      <ul>
        {
          certifications.map((cert) => (
            <li class="mb-2">
              <span class="font-medium">{cert.name}</span>
              <br />
              <span class="text-sm text-gray-600">
                {cert.issuer}, {cert.year}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="mb-4 text-2xl font-medium">Education</h2>
      <p class="font-medium">Computer Science</p>
      <p class="text-sm text-gray-600">Delaware Technical Community College, Georgetown, DE · 2024</p>
    </div>
  </section>
</Layout>
