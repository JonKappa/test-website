---
import '../styles.css';
import Nav from '../components/Nav.vue';
import Footer from '../components/Footer.vue';
import { ClientRouter } from 'astro:transitions';

interface Props {
  /** Page name shown before the site name in the tab title, e.g. "Projects". */
  title?: string;
}

const siteName = 'Jonathan Capparell';
const title = Astro.props.title ? `${Astro.props.title} | ${siteName}` : siteName;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Nav base={base} path={path} />
    <div class="mx-auto mt-4 max-w-[1140px] px-3 text-center">
      <slot />
    </div>
    <Footer base={base} />
  </body>
</html>
